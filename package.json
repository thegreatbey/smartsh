{
  "name": "smartsh",
  "version": "0.4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/thegreatbey/smartsh.git"
  },
  "main": "dist/index.js",
  "devDependencies": {
    "@types/node": "^24.0.10",
    "esbuild": "^0.25.9",
    "tsup": "^8.1.1",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "bin": {
    "smartsh": "dist/cli.js",
    "sm": "dist/cli.js"
  },
  "description": "Cross-shell command runner enabling Unix-style syntax on any OS.",
  "engines": {
    "node": ">=14"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cli",
    "shell",
    "cross-platform",
    "command-runner",
    "powershell",
    "cmd",
    "bash",
    "unix-commands",
    "pipeline",
    "npm-exec"
  ],
  "license": "MIT",
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "bun node_modules/tsup/dist/cli-default.js src/index.ts src/cli.ts --format cjs,esm --sourcemap --dts --clean",
    "postbuild": "node -e \"const fs=require('fs'),p='dist/cli.js';if(fs.existsSync(p)){let s=fs.readFileSync(p,'utf8');if(!s.startsWith('#!'))fs.writeFileSync(p,'#!/usr/bin/env node\\n'+s)}\"",
    "dev": "bun node_modules/tsup/dist/cli-default.js --watch",
    "test": "vitest run",
    "bump:patch": "node scripts/bump-patch.js",
    "lint": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  }
}
